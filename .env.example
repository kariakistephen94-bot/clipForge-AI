# Copy this file to .env and fill in values. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave blank to use the app default (gemini-3.8-flash). Any Gemini model that accepts video works.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Optional: publishing to your own accounts. See PUBLISHING.md for step-by-step setup.
# YouTube: Google Cloud console -> YouTube Data API v3 -> OAuth client (Web application)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok: developers.tiktok.com -> your app -> Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
